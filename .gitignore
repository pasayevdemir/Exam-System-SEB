# Peerstack Exam System — ignore rules
#
# Ordering matters: negations (!) must come after the pattern they carve an
# exception out of, and a directory excluded here cannot be re-included by a
# later rule for a file inside it.

# ---------------------------------------------------------------------------
# Environment and secrets
# ---------------------------------------------------------------------------
# .env holds APP_KEY, database credentials and SEB_CONFIG_KEY. It lives only on
# the machine that runs the app; the *.example files are the committed template.
.env
.env.*
!.env.example
!.env.*.example

# Private keys and certificates in every form we might plausibly produce.
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.ppk
*.jks
*.keystore
id_rsa
id_rsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*
/storage/*.key
secrets.json
credentials.json
auth.json
/auth.json

# ---------------------------------------------------------------------------
# Database dumps and backups
# ---------------------------------------------------------------------------
# Production dumps contain student names, FIN codes and exam results, and the
# deploy script writes one before every release. A dump must never reach a
# public repository, so the extensions are blocked outright rather than by name.
*.sql
*.sql.gz
*.dump
*.sqlite
*.sqlite3
*.db
env.backup
*.backup
*.bak
*.orig

# Archives — usually an ad-hoc export or a copied release.
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
/vendor
/node_modules

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
/public/build
/public/hot
# Symlink created by `php artisan storage:link`; it is generated per
# environment, and inside the production image it is recreated on every deploy.
/public/storage

# ---------------------------------------------------------------------------
# Laravel runtime
# ---------------------------------------------------------------------------
*.log
/storage/pail
/storage/debugbar
/storage/clockwork
/.phpunit.cache
.phpunit.result.cache

# ---------------------------------------------------------------------------
# Testing and coverage
# ---------------------------------------------------------------------------
/coverage
/.nyc_output
clover.xml
coverage.xml
junit.xml

# ---------------------------------------------------------------------------
# Local infrastructure overrides
# ---------------------------------------------------------------------------
# docker-compose.override.yml is Compose's own per-developer escape hatch; it is
# loaded automatically and is meant to stay local.
docker-compose.override.yml
docker-compose.*.local.yml
Homestead.json
Homestead.yaml
.vagrant

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
/.idea
/.vscode
/.fleet
/.nova
/.zed
.phpactor.json
*.swp
*.swo
*~
.*.sw[a-p]

# ---------------------------------------------------------------------------
# AI and agent tooling
# ---------------------------------------------------------------------------
/.claude
/.cursor
/.grok
/.aider*
# Knowledge-graph build output: regenerated from the sources on demand.
/graphify-out

# ---------------------------------------------------------------------------
# Operating system noise
# ---------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---------------------------------------------------------------------------
# Project-specific
# ---------------------------------------------------------------------------
# Question sets staged for import through the admin panel. They are real exam
# content, so they stay out of a public repository.
questions.json
/import/
